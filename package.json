{
  "name": "micro-mayhem",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Micro Mayhem: top-down toy-car combat racer. Dev tooling only; nothing here ships to players.",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:sim": "node --test \"tests/sim/*.test.js\"",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/*.test.js\"",
    "study": "node tools/driver-study.js",
    "perf": "node tools/perf.js",
    "test:ci": "node --test --test-reporter=spec --test-concurrency=1 \"tests/**/*.test.js\"",
    "stage": "node tools/stage-site.mjs _site",
    "lint": "eslint .",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "perf:cpu": "node tools/perf-cpu.mjs",
    "golden": "node tools/golden.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "playwright": "1.63.0"
  }
}
